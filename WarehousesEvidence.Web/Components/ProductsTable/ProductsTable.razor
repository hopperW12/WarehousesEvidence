@using WarehousesEvidence.Data.Entities

<MudTable T="Product" Items="@Products" Hover="true" SortLabel="Seřadit" OnRowClick="RowClickEvent">
    <ToolBarContent>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => CreateProduct())">Nový produkt</MudButton>
    </ToolBarContent>
    <HeaderContent>
        <MudTh><MudTableSortLabel SortBy="new Func<Product, object>(x => x.Name)">Název</MudTableSortLabel></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTh DataLabel="Název">@context.Name</MudTh>
    </RowTemplate>
    <PagerContent>
        <MudTablePager RowsPerPageString="Počet řádků" PageSizeOptions="new[] { 5, 10, 25 }"/>
    </PagerContent>
</MudTable>