<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All">Celkový přehled</MudNavLink>
    <MudNavLink Href="/warehouses" Match="NavLinkMatch.Prefix">Sklady</MudNavLink>
    <MudNavLink Href="/products" Match="NavLinkMatch.Prefix">Produkty</MudNavLink>
    @if (Warehouses.Count > 0)
    {
        <MudNavGroup Title="Seznam skladů">
            @foreach (var warehouse in Warehouses)
            {
                var url = $"/warehouse/{warehouse.SlagName}";
                <MudNavLink Href="@url" Match="NavLinkMatch.Prefix">@warehouse.Name</MudNavLink>
            }
        </MudNavGroup>
    }
</MudNavMenu>