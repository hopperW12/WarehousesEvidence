@page "/products"
@using WarehousesEvidence.Data.Entities

<MudTable Items="@Products" Hover="true" SortLabel="Sort By">
    <HeaderContent>
        <MudTh><MudTableSortLabel SortBy="new Func<Product, object>(x=>x.Name)">Jméno</MudTableSortLabel></MudTh>
    </HeaderContent>
    <PagerContent>
        <MudTablePager RowsPerPageString="Počet řádků" PageSizeOptions="new [] { 10, 25, 50, 100 }" />
    </PagerContent>
</MudTable>
